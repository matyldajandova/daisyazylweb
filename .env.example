# These are used by the Vercel serverless OAuth routes (production /admin login).
# Set them in the Vercel project → Settings → Environment Variables.
# Local editing does NOT need them — use `npm run cms:local` (decap-server) instead.

# Public site URL used for Decap GitHub OAuth, e.g. https://your-app.vercel.app
CMS_BASE_URL=

# GitHub OAuth App credentials (callback = https://your-domain/api/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
