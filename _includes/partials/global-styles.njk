<div class="global-styles">
  <div class="style-overrides w-embed">
    <style>
      /* Ensure all elements inherit the color from its parent */
      a,
      .w-input,
      .w-select,
      .w-tab-link,
      .w-nav-link,
      .w-nav-brand,
      .w-dropdown-btn,
      .w-dropdown-toggle,
      .w-slider-arrow-left,
      .w-slider-arrow-right,
      .w-dropdown-link {
        color: inherit;
        text-decoration: inherit;
        font-size: inherit;
      }

      /* Visually hidden but accessible text (for hidden headings, etc.) */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Variant for elements that should become visible when focused (e.g. skip links) */
      .sr-only-focusable:active,
      .sr-only-focusable:focus {
        position: static;
        width: auto;
        height: auto;
        padding: 0.5rem 1rem;
        margin: 0.5rem;
        overflow: visible;
        clip: auto;
        white-space: normal;
        border-radius: 0.25rem;
        background-color: #ffffff;
        color: #000000;
        z-index: 1000;
      }

      /* Font smoothing across the site */
      * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        -o-font-smoothing: antialiased;
      }

      /* Focus state style for keyboard navigation for the focusable elements */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible,
      *[tabindex]:focus-visible {
        outline: 0.125rem solid #4d65ff;
        outline-offset: 0.125rem;
      }

      /* Get rid of top margin on first element in any rich text element */
      .w-richtext > :not(div):first-child,
      .w-richtext > div:first-child > :first-child {
        margin-top: 0 !important;
      }

      /* Get rid of bottom margin on last element in any rich text element */
      .w-richtext > :last-child,
      .w-richtext ol li:last-child,
      .w-richtext ul li:last-child {
        margin-bottom: 0 !important;
      }

      /* Prevent all click and hover interaction with an element */
      .pointer-events-off {
        pointer-events: none;
      }

      /* Enables all click and hover interaction with an element */
      .pointer-events-on {
        pointer-events: auto;
      }

      /* Create a class of .div-square which maintains a 1:1 dimension of a div */
      .div-square::after {
        content: "";
        display: block;
        padding-bottom: 100%;
      }

      /* Make sure containers never lose their center alignment */
      .container-medium,
      .container-small,
      .container-large {
        margin-right: auto !important;
        margin-left: auto !important;
      }

      /* Apply "..." after 3 lines of text */
      .text-style-3lines {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
      }

      /* Apply "..." after 2 lines of text */
      .text-style-2lines {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }

      /* Adds inline flex display */
      .display-inlineflex {
        display: inline-flex;
      }

      /* These classes are never overwritten */
      .hide {
        display: none !important;
      }

      /* Remove default Webflow chevron from form select */
      select {
        -webkit-appearance: none;
      }

      @media screen and (max-width: 991px) {
        .hide,
        .hide-tablet {
          display: none !important;
        }
      }

      @media screen and (max-width: 767px) {
        .hide-mobile-landscape {
          display: none !important;
        }
      }

      @media screen and (max-width: 479px) {
        .hide-mobile {
          display: none !important;
        }
      }

      .margin-0 {
        margin: 0rem !important;
      }

      .padding-0 {
        padding: 0rem !important;
      }

      .spacing-clean {
        padding: 0rem !important;
        margin: 0rem !important;
      }

      .margin-top {
        margin-right: 0rem !important;
        margin-bottom: 0rem !important;
        margin-left: 0rem !important;
      }

      .padding-top {
        padding-right: 0rem !important;
        padding-bottom: 0rem !important;
        padding-left: 0rem !important;
      }

      .margin-right {
        margin-top: 0rem !important;
        margin-bottom: 0rem !important;
        margin-left: 0rem !important;
      }

      .padding-right {
        padding-top: 0rem !important;
        padding-bottom: 0rem !important;
        padding-left: 0rem !important;
      }

      .margin-bottom {
        margin-top: 0rem !important;
        margin-right: 0rem !important;
        margin-left: 0rem !important;
      }

      .padding-bottom {
        padding-top: 0rem !important;
        padding-right: 0rem !important;
        padding-left: 0rem !important;
      }

      .margin-left {
        margin-top: 0rem !important;
        margin-right: 0rem !important;
        margin-bottom: 0rem !important;
      }

      .padding-left {
        padding-top: 0rem !important;
        padding-right: 0rem !important;
        padding-bottom: 0rem !important;
      }

      .margin-horizontal {
        margin-top: 0rem !important;
        margin-bottom: 0rem !important;
      }

      .padding-horizontal {
        padding-top: 0rem !important;
        padding-bottom: 0rem !important;
      }

      .margin-vertical {
        margin-right: 0rem !important;
        margin-left: 0rem !important;
      }

      .padding-vertical {
        padding-right: 0rem !important;
        padding-left: 0rem !important;
      }

      /* Apply "..." at 100% width */
      .truncate-width {
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Removes native scrollbar */
      .no-scrollbar {
        -ms-overflow-style: none;
        overflow: -moz-scrollbars-none;
      }

      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }

      /* Widen navbar pill to match content container width */
      .navbar14_container {
        max-width: 80rem;
      }

      /* Extra bottom breathing room on the "Co děláme" section – desktop only */
      @media screen and (min-width: 768px) {
        .section_layout484 .padding-section-large {
          padding-bottom: 15rem;
        }
      }

      /* Navbar and footer link color overrides */
      .navbar14_link.w--current {
        color: #519c61;
      }

      /* Footer links: off-white base, yellow hover; nav and cookies use dark (same as nav) */
      .footer15_component .link {
        color: var(--_primitives---colors--off-white);
        font-size: 0.875rem;
      }
      .footer15_component .link:hover {
        color: var(--_primitives---colors--yellow);
      }
      .footer15_link,
      .footer15_legal-link {
        font-size: .875rem;
      }
      .footer15_link,
      .footer15_link:hover,
      .footer15_legal-link,
      .footer15_legal-link:hover {
        color: var(--_primitives---colors--dark-green);
      }

      /* Navbar: sticky fixed, hides on scroll-down, slides back on scroll-up */
      .navbar14_component {
        transition: transform 0.25s ease;
        will-change: transform;
      }
      .navbar14_component.is-nav-hidden {
        transform: translateY(-150%);
      }

      /* Body-level backdrop injected by JS when mobile menu opens.
         Lives outside the navbar stacking context so it covers the viewport
         from top: 0 regardless of the navbar's own margin-top. */
      #nav-menu-backdrop {
        position: fixed;
        inset: 0;
        background-color: var(--_primitives---colors--dark-green);
        z-index: 999;
        pointer-events: none;
      }

      /* ── Support section: method card grid ────────────────────────── */

      .support-account-card {
        grid-template-columns: 1fr;
      }

      .support-account-link {
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
      }

      .support-methods-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-column-gap: 1.25rem;
        grid-row-gap: 1.25rem;
        margin-top: 0;
      }

      .support-method-card {
        display: flex;
        gap: 1rem;
        background-color: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
        align-items: flex-start;
      }

      .support-method-card:hover {
        background-color: rgba(255, 255, 255, 0.13);
        border-color: var(--_primitives---colors--yellow);
        transform: translateY(-2px);
      }

      .support-method-card .heading-style-h6 {
        transition: color 0.2s ease;
      }

      .support-method-card:hover .heading-style-h6 {
        color: var(--_primitives---colors--yellow);
      }

      .support-reconstruction-note {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 3rem 0 1rem;
        gap: 0.75rem;
        margin-top: 3rem;
        max-width: 44rem;
        margin-left: auto;
        margin-right: auto;
      }

      .support-reconstruction-icon {
        width: 2.5rem;
        height: 2.5rem;
      }

      .support-icon-bare {
        height: 2.25rem;
        width: auto;
        flex: none;
      }

      .support-logo-container {
        background: white;
        border-radius: 8px;
        padding: 0.35rem 0.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
      }

      .support-logo-img {
        height: 1.6rem;
        width: auto;
        max-width: 5.5rem;
        display: block;
      }

      .cta-illustration {
        position: absolute;
        bottom: 0;
        right: 5rem;
        height: 90%;
        width: auto;
        pointer-events: none;
        z-index: 1;
      }

      /* On mobile the card collapses to 1 column — take the illustration out of
         absolute positioning so it flows naturally below the text content */
      @media screen and (max-width: 991px) {
        .cta39_card-content {
          padding-right: 2.75rem !important;
        }

        .cta-illustration {
          position: relative;
          bottom: auto;
          right: auto;
          height: auto;
          width: 55%;
          max-height: 200px;
          object-fit: contain;
          display: block;
          margin: 0 auto;
        }
      }

      @media screen and (max-width: 991px) {
        .support-methods-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .support-account-card {
          max-width: 100%;
        }
      }

      @media screen and (max-width: 767px) {
        .support-method-card {
          flex-direction: column;
        }
      }

      @media screen and (max-width: 479px) {
        .support-methods-grid {
          grid-template-columns: 1fr;
        }

        .support-method-card {
          padding: 1.25rem;
        }

        .cta-illustration {
          width: 65%;
          max-height: 180px;
        }

        .money {
          font-size: 1.25rem;
          padding-right: 8px;
        }

        .money-p {
          font-size: 1.25rem;
        }
      }

      .section_layout58 .padding-section-large {
        padding-bottom: 12rem;
      }

      @media screen and (max-width: 767px) {
        .section_layout58 .padding-section-large {
          padding-bottom: 8rem;
        }
      }

      /* ── End support section ───────────────────────────────────────── */

      @media screen and (max-width: 991px) {
        /* Overlay is a sibling of the navbar, placed directly in body so it
           is not clipped by the navbar's own stacking context */
        body > .page-wrapper > main > .navbar14_component.w-nav {
          /* intentionally not changing z-index here — handled below */
        }

        /* The overlay must escape the navbar's stacking context entirely.
           We achieve this by giving the navbar a very high z-index, the overlay
           a z-index that beats page content but is still within the navbar's
           stacking context, and the pill + button even higher so they float on top. */
        .navbar14_component {
          z-index: 1000;
        }

        /* Overlay covers the full viewport from very top */
        .navbar14_component .w-nav-overlay {
          position: fixed !important;
          top: 0 !important;
          left: 0 !important;
          width: 100vw !important;
          height: 100dvh !important;
          /* z-index within .navbar14_component's stacking context — beats page (z-index:0) */
          z-index: 900;
          background-color: var(--_primitives---colors--dark-green);
        }

        .navbar14_component .w-nav-overlay [data-nav-menu-open] {
          height: 100dvh;
          background-color: var(--_primitives---colors--dark-green);
        }

        /* Pill row above the overlay */
        .navbar14_component .navbar14_container {
          position: relative;
          z-index: 950;
        }

        /* Hamburger / close button above everything */
        .navbar14_component .navbar14_menu-button {
          display: block;
          position: relative;
          z-index: 960;
        }

        .navbar14_component .navbar14_menu {
          display: none;
          position: absolute;
        }

        .navbar14_component .navbar14_menu.w--nav-menu-open,
        .navbar14_component .w-nav-overlay [data-nav-menu-open] {
          display: block !important;
        }

        .navbar14_component .navbar14_menu-link-wrapper {
          display: flex;
          min-height: 100dvh;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 1.25rem;
          padding: 6.5rem 1.5rem 1.5rem;
          background-color: var(--_primitives---colors--dark-green);
        }

        .navbar14_component .navbar14_menu-links {
          display: flex;
          width: 100%;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 1.25rem;
        }

        .navbar14_component .navbar14_menu-links .navbar14_link {
          font-size: clamp(1.9rem, 5vw, 2.4rem);
          line-height: 1.2;
        }

        .navbar14_component .navbar14_button-wrapper {
          margin-top: auto;
          width: 100%;
          display: flex;
          justify-content: center;
          padding-bottom: 1rem;
        }

        .navbar14_component .menu-icon2_line-top,
        .navbar14_component .menu-icon2_line-middle,
        .navbar14_component .menu-icon2_line-bottom {
          transition: transform 0.2s ease, opacity 0.2s ease;
          transform-origin: center;
        }

        .navbar14_component .navbar14_menu-button.w--open .menu-icon2_line-top {
          transform: translateY(8px) rotate(45deg);
        }

        .navbar14_component .navbar14_menu-button.w--open .menu-icon2_line-middle {
          opacity: 0;
          transform: scaleX(0.6);
        }

        .navbar14_component .navbar14_menu-button.w--open .menu-icon2_line-bottom {
          transform: translateY(-8px) rotate(-45deg);
        }
      }
    </style>
  </div>
  <div class="color-schemes w-embed">
    <style>
      /* Color Schemes Controls*/
      .color-scheme-1 {
        /*All sections should point to Color Scheme 1*/
      }

      .color-scheme-2 {
        --color-scheme-1--text: var(--color-scheme-2--text);
        --color-scheme-1--background: var(--color-scheme-2--background);
        --color-scheme-1--foreground: var(--color-scheme-2--foreground);
        --color-scheme-1--border: var(--color-scheme-2--border);
        --color-scheme-1--accent: var(--color-scheme-2--accent);
      }

      .color-scheme-3 {
        --color-scheme-1--text: var(--color-scheme-3--text);
        --color-scheme-1--background: var(--color-scheme-3--background);
        --color-scheme-1--foreground: var(--color-scheme-3--foreground);
        --color-scheme-1--border: var(--color-scheme-3--border);
        --color-scheme-1--accent: var(--color-scheme-3--accent);
      }

