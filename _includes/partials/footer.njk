{% assign footer_shelter_active = false %}
{% if currentPage == 'nasi-sverenci' %}{% assign footer_shelter_active = true %}{% endif %}
{% if currentPage == 'sverenec-detail' %}
  {% assign footer_shelter_active = true %}
{% endif %}
<div class="footer-wrapper">
  <div class="dog-wrapper">
    <img src="images/dog_1.svg" loading="lazy" alt="" class="footer-dog" />
    <img src="images/strokes.svg" loading="lazy" alt="" class="footer-strokes" />
  </div>
  <footer id="contact" class="footer15_component" aria-label="Kontaktní informace a odkazy">
    <img src="images/grass.svg" loading="lazy" alt="" class="footer-grass" />
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-vertical padding-xxlarge">
          <div class="padding-bottom padding-large">
            <div class="footer15_image-wrapper">
              <img
                loading="lazy"
                src="images/logo-footer.svg"
                alt="Daisy azyl logo"
                class="footer15_image"
              />
              <div
                id="w-node-f509c98a-3d9a-d73c-3b98-de97180a4c19-d5b795d3"
                class="w-layout-grid footer15_menu-wrapper"
              >
                <div class="footer15_link-list">
                  <a href="/#o-nas" class="footer15_link">O nás</a>
                  <a href="/#podpora" class="footer15_link">Podpořte nás</a>
                  <a href="/#contact" class="footer15_link">Náš tým</a>
                  <a
                    href="/nasi-sverenci/"
                    class="footer15_link{% if footer_shelter_active %} w--current{% endif %}"
                    {% if footer_shelter_active %}aria-current="page"{% endif %}
                    >Naši svěřenci</a>
                  {% if site.featureFlags.showAktuality %}
                    <a
                      href="/aktuality/"
                      class="footer15_link{% if currentPage == 'aktuality' %} w--current{% endif %}"
                      {% if currentPage == 'aktuality' %}aria-current="page"{% endif %}
                      >Aktuality</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          <div class="padding-bottom padding-xlarge">
            <div class="w-layout-grid footer15_top-wrapper">
              <div class="footer15_left-wrapper">
                <div class="margin-bottom margin-small">
                  <h2>Kontakty</h2>
                </div>
                <div class="margin-bottom margin-medium">
                  <div class="footer15_details-wrapper">
                    <div class="margin-bottom margin-tiny">
                      <div class="text-size-small text-weight-semibold text-color-dark-green">
                        Daisy azyl z.s.
                      </div>
                    </div>
                    <div class="margin-bottom margin-small">
                      <div class="text-size-small text-color-dark-green">
                        Nový 30, 28903 Městec Králové
                      </div>
                      <div class="text-size-small text-color-dark-green">IČO: 21636982</div>
                    </div>
                    <div class="text-size-small text-color-dark-green">
                      V případě dotazů nás kontaktujte na
                      <a
                        target="_blank"
                        href="https://www.facebook.com/daisyazyl"
                        class="link"
                        >FB Messengeru</a> nebo na:
                    </div>
                    <div class="icon-wrapper">
                      <img src="images/phone.svg" loading="lazy" alt="phone icon" />
                      <a href="tel:+420605793896" class="link">605&nbsp;793&nbsp;896</a>
                    </div>
                    <div class="icon-wrapper">
                      <img src="images/email.svg" loading="lazy" alt="email icon" />
                      <a
                        href="mailto:daisyazyl@gmail.com?subject=P%C5%99i%C5%A1el%20V%C3%A1m%20email%20z%20webu"
                        class="link"
                        >daisyazyl@gmail.com</a
                      >
                    </div>
                    <div class="icon-wrapper">
                      <img
                        src="images/instagram.svg"
                        loading="lazy"
                        alt="Instagram icon"
                        width="16"
                        height="16"
                        style="padding: 1px"
                      />
                      <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://www.instagram.com/daisyazylzs/"
                        class="link"
                        >Instagram</a
                      >
                    </div>
                  </div>
                </div>
              </div>
              <div class="footer15_left-wrapper">
                <div class="margin-bottom margin-small">
                  <h2>Náš tým</h2>
                </div>
                <div class="margin-bottom margin-medium">
                  <div class="footer15_details-wrapper">
                    <div class="margin-bottom margin-small">
                      <div class="margin-bottom margin-tiny">
                        <div class="text-size-small text-weight-semibold text-color-dark-green">
                          <strong>Tereza Jandová</strong>
                        </div>
                      </div>
                      <div class="text-size-small text-color-dark-green">
                        předsedkyně spolku, organizace, komunikace, přímá péče o zvířata a chod azylu
                      </div>
                    </div>
                    <div class="margin-bottom margin-small">
                      <div class="margin-bottom margin-tiny">
                        <div class="text-size-small text-weight-semibold text-color-dark-green">
                          <strong>Alžběta Brühl</strong>
                        </div>
                      </div>
                      <div class="text-size-small text-color-dark-green">
                        komunikace, PR, správa Facebooku, dočasná péče
                      </div>
                    </div>
                    <div class="margin-bottom margin-small">
                      <div class="margin-bottom margin-tiny">
                        <div class="text-size-small text-weight-semibold text-color-dark-green">
                          <strong>Pavla Čermáková</strong>
                        </div>
                      </div>
                      <div class="text-size-small text-color-dark-green">
                        komunikace, správa sociálních sítí, fundraising, dočasná péče
                      </div>
                    </div>
                    <div>
                      <div class="margin-bottom margin-tiny">
                        <div class="text-size-small text-weight-semibold text-color-dark-green">
                          <strong>Iveta Bartošová Lehotská</strong>
                        </div>
                      </div>
                      <div class="text-size-small text-color-dark-green">
                        přímá péče o zvířata a chod azylu
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% if partners.partners and partners.partners.size > 0 %}
          <div class="padding-bottom padding-large">
            <div class="margin-bottom margin-small">
              <h2>Naši partneři</h2>
            </div>
            <div class="footer-partners-list">
              {% for partner in partners.partners %}
                {% if partner.url and partner.url != "" %}
                  <a
                    href="{{ partner.url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-partner-link"
                  >
                    <span class="footer-partner-logo-container">
                      <img
                        src="{{ partner.logo }}"
                        alt="{{ partner.name }}"
                        loading="lazy"
                        class="footer-partner-logo"
                      />
                    </span>
                  </a>
                {% else %}
                  <span class="footer-partner-logo-container">
                    <img
                      src="{{ partner.logo }}"
                      alt="{{ partner.name }}"
                      loading="lazy"
                      class="footer-partner-logo"
                    />
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}
          <div class="divider-horizontal"></div>
          <div class="padding-top padding-medium">
            <div class="footer15_bottom-wrapper">
              <div class="footer15_credit-text">
                © 2024 Daisy azyl. Všechna práva vyhrazena.
              </div>
              <div class="w-layout-grid footer15_legal-list">
                <a href="/ochrana-osobnich-udaju/" class="footer15_legal-link{% if currentPage == 'ochrana-osobnich-udaju' %} w--current{% endif %}"{% if currentPage == 'ochrana-osobnich-udaju' %} aria-current="page"{% endif %}>Ochrana osobních údajů</a>
                <a href="/dokumenty/" class="footer15_legal-link{% if currentPage == 'dokumenty' %} w--current{% endif %}"{% if currentPage == 'dokumenty' %} aria-current="page"{% endif %}>Dokumenty</a>
                <a href="/vyrocni-zpravy/" class="footer15_legal-link{% if currentPage == 'vyrocni-zpravy' %} w--current{% endif %}"{% if currentPage == 'vyrocni-zpravy' %} aria-current="page"{% endif %}>Výroční zprávy</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>

