{% comment %}
  Schema.org JSON-LD: AnimalShelter, WebPage, BreadcrumbList; ItemList on listings; Thing for sverenec-detail.
{% endcomment %}
{% if noindex %}{% else %}
{% assign canonicalPath = permalink | default: page.url | default: "/" %}
{% if canonicalPath == "" %}{% assign canonicalPath = "/" %}{% endif %}
{% unless canonicalPath contains "/" %}{% assign canonicalPath = "/" | append: canonicalPath %}{% endunless %}
{% assign canonicalUrl = site.siteUrl | append: canonicalPath %}
{% if animal %}
  {% assign speciesLabel = animal.species | default: "zvíře" %}
  {% assign pageTitle = animal.name | append: " – " | append: speciesLabel | append: " | Daisy Azyl" %}
  {% assign pageDesc = animal.shortDescription %}
{% else %}
  {% assign pageTitle = title | default: "Daisy Azyl" %}
  {% assign pageDesc = description %}
{% endif %}
{% assign breadcrumbUrl = site.siteUrl %}
{% assign breadcrumbName = "Úvod" %}
{% if currentPage == "nasi-sverenci" %}
  {% if listing and listing.permalink %}
    {% assign breadcrumbUrl = site.siteUrl | append: listing.permalink %}
    {% if listing.categoryLabel %}
      {% assign breadcrumbName = listing.categoryLabel | append: " – " | append: listing.speciesLabel %}
    {% else %}
      {% assign breadcrumbName = listing.speciesLabel | default: "Naši svěřenci" %}
    {% endif %}
  {% else %}
    {% assign breadcrumbUrl = site.siteUrl | append: "/nasi-sverenci/" %}
    {% assign breadcrumbName = "Naši svěřenci" %}
  {% endif %}
{% endif %}
{% if currentPage == "sverenec-detail" %}
  {% if animal.listingHref %}
    {% assign breadcrumbUrl = site.siteUrl | append: animal.listingHref %}
  {% else %}
    {% assign breadcrumbUrl = site.siteUrl | append: "/nasi-sverenci/" %}
  {% endif %}
  {% assign breadcrumbName = animal.categoryLabel | default: "Naši svěřenci" %}
{% endif %}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"AnimalShelter","@id":"{{ site.siteUrl }}/#organization","name":"{{ site.legalName }}","legalName":"{{ site.legalName }}","url":"{{ site.siteUrl }}","logo":"{{ site.siteUrl }}/images/logo-footer.svg","image":"{{ site.siteUrl }}/images/og.png","description":"Azyl pro staré, týrané, hendikepované, pejsky a kočičky.","address":{"@type":"PostalAddress","streetAddress":"{{ site.address.streetAddress }}","addressLocality":"{{ site.address.addressLocality }}","postalCode":"{{ site.address.postalCode }}","addressCountry":"{{ site.address.addressCountry }}"},"telephone":"{{ site.contact.telephone }}","email":"{{ site.contact.email }}","sameAs":["{{ site.contact.facebook }}","{{ site.contact.instagram }}"],"areaServed":{"@type":"Country","name":"Česká republika"},"taxID":"{{ site.taxID }}"},
{"@type":"WebPage","@id":"{{ canonicalUrl }}#webpage","url":"{{ canonicalUrl }}","name":{{ pageTitle | json }},"description":{{ pageDesc | json }},"isPartOf":{"@id":"{{ site.siteUrl }}/#organization"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"{{ breadcrumbName }}","item":"{{ breadcrumbUrl }}"}{% if currentPage == "sverenec-detail" and animal %},{"@type":"ListItem","position":2,"name":{{ animal.name | json }},"item":"{{ canonicalUrl }}"}{% endif %}]}}
{% if currentPage == "nasi-sverenci" and listing and listing.animals and listing.animals.size > 0 %},{"@type":"ItemList","itemListElement":[{% for animal in listing.animals %}{"@type":"ListItem","position":{{ forloop.index }},"url":"{{ site.siteUrl }}/sverenec/{{ animal.slug }}/","name":{{ animal.name | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% endif %}
{% if animal %},{"@type":"Thing","name":{{ animal.name | json }},"description":{{ animal.shortDescription | json }},"image":"{% if animal.image contains 'http' %}{{ animal.image }}{% else %}{{ site.siteUrl }}{% assign imageFirstChar = animal.image | slice: 0, 1 %}{% if imageFirstChar != '/' %}/{% endif %}{{ animal.image }}{% endif %}"}{% endif %}
]}
</script>
{% endif %}
