{% assign current = currentPage | default: "" %}
<div
  data-collapse="medium"
  data-animation="default"
  data-duration="240"
  data-w-id="6e9062d5-75dd-4378-1beb-ebce66c57360"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="navbar14_component w-nav"
>
  <div class="navbar14_container">
    <a
      href="/"
      class="navbar14_logo-link w-nav-brand{% if current == 'home' %} w--current{% endif %}"
      {% if current == 'home' %}aria-current="page"{% endif %}
      ><img loading="lazy" src="images/logo-daisy.svg" alt="logo" class="navbar14_logo"
    /></a>
    <nav
      role="navigation"
      aria-label="Hlavní navigace"
      id="w-node-_6e9062d5-75dd-4378-1beb-ebce66c57364-66c57360"
      class="navbar14_menu w-nav-menu"
    >
      <div class="navbar14_menu-link-wrapper">
        <div class="navbar14_menu-links">
          <a href="/#o-nas" class="navbar14_link w-nav-link">O nás</a>
          <a href="/#podpora" class="navbar14_link w-nav-link">Podpořte nás</a>
          <a href="/#contact" class="navbar14_link w-nav-link">Náš tým</a>
          <a
            href="/adopce/"
            class="navbar14_link w-nav-link{% if current == 'adopce' or current == 'adopce-detail' %} w--current{% endif %}"
            {% if current == 'adopce' or current == 'adopce-detail' %}aria-current="page"{% endif %}
            >Naši svěřenci</a>
          <a
            href="/adopce/"
            class="navbar14_link w-nav-link"
            >Našli domov</a>
          <a
            href="/aktuality/"
            class="navbar14_link w-nav-link{% if current == 'aktuality' %} w--current{% endif %}"
            {% if current == 'aktuality' %}aria-current="page"{% endif %}
            >Aktuality</a>
        </div>
        <div
          id="w-node-_6e9062d5-75dd-4378-1beb-ebce66c57379-66c57360"
          class="navbar14_button-wrapper"
        >
          <a href="#contact" class="button w-button">Kontakt</a>
        </div>
      </div>
    </nav>
    <div
      class="navbar14_menu-button w-nav-button"
      aria-label="Otevřít hlavní menu"
      aria-expanded="false"
      aria-controls="w-node-_6e9062d5-75dd-4378-1beb-ebce66c57364-66c57360"
    >
      <div class="menu-icon2">
        <div class="menu-icon2_line-top"></div>
        <div class="menu-icon2_line-middle">
          <div class="menu-icon1_line-middle-inner"></div>
        </div>
        <div class="menu-icon2_line-bottom"></div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var nav = document.querySelector(".navbar14_component.w-nav");
    var menuButton = document.querySelector(".navbar14_menu-button.w-nav-button");
    var navMenu = document.getElementById(
      "w-node-_6e9062d5-75dd-4378-1beb-ebce66c57364-66c57360",
    );

    if (!nav || !menuButton || !navMenu) return;

    // ── Scroll lock (position:fixed approach – reliable on all mobile browsers) ──
    var savedScrollY = 0;
    var scrollLocked = false;

    function lockScroll() {
      if (scrollLocked) return;
      savedScrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = "-" + savedScrollY + "px";
      document.body.style.width = "100%";
      document.body.style.overflow = "hidden";
      scrollLocked = true;
    }

    function unlockScroll() {
      if (!scrollLocked) return;
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      document.body.style.overflow = "";
      // Sync lastScrollY before restoring scroll so the scroll event that fires
      // does not trigger the hide-on-scroll logic (would see a false downward jump)
      lastScrollY = savedScrollY;
      window.scrollTo(0, savedScrollY);
      scrollLocked = false;
    }

    function isMobile() {
      return window.matchMedia("(max-width: 991px)").matches;
    }

    // ── Menu state (MutationObserver – reacts to Webflow's own class changes) ──
    var menuOpen = false;
    var menuBackdrop = null;

    function onMenuOpen() {
      menuOpen = true;
      menuButton.setAttribute("aria-expanded", "true");
      if (isMobile()) {
        lockScroll();
        // Inject a body-level backdrop so the area above the floating navbar
        // (navbar has margin-top / will-change:transform stacking context) is covered
        if (!menuBackdrop) {
          menuBackdrop = document.createElement("div");
          menuBackdrop.id = "nav-menu-backdrop";
          document.body.appendChild(menuBackdrop);
        }
      }
    }

    function onMenuClose() {
      menuOpen = false;
      menuButton.setAttribute("aria-expanded", "false");
      unlockScroll();
      nav.classList.remove("is-nav-hidden");
      if (menuBackdrop) {
        menuBackdrop.remove();
        menuBackdrop = null;
      }
    }

    var observer = new MutationObserver(function () {
      var isOpen = menuButton.classList.contains("w--open");
      if (isOpen && !menuOpen) {
        onMenuOpen();
      } else if (!isOpen && menuOpen) {
        onMenuClose();
      }
    });

    observer.observe(menuButton, { attributes: true, attributeFilter: ["class"] });

    // ── Close menu when any nav link is clicked (anchor links stay on same page) ──
    navMenu.addEventListener("click", function (event) {
      var link = event.target.closest("a");
      if (link && menuOpen) {
        menuButton.click();
      }
    });

    // Unlock if resized to desktop while menu is logically open
    window.addEventListener("resize", function () {
      if (!isMobile() && scrollLocked) unlockScroll();
    });

    // ── Hide navbar on scroll-down, show immediately on scroll-up ──
    var lastScrollY = window.scrollY;
    var scrollTicking = false;
    // Only start hiding after scrolling past the navbar height + a small buffer
    var HIDE_THRESHOLD = (nav.offsetHeight || 80) + 40;

    function onScroll() {
      if (menuOpen) {
        lastScrollY = window.scrollY;
        scrollTicking = false;
        return;
      }
      var current = window.scrollY;
      if (current > lastScrollY && current > HIDE_THRESHOLD) {
        // Scrolling down — hide
        nav.classList.add("is-nav-hidden");
      } else if (current < lastScrollY) {
        // Scrolling up — show immediately
        nav.classList.remove("is-nav-hidden");
      }
      lastScrollY = current;
      scrollTicking = false;
    }

    window.addEventListener("scroll", function () {
      if (!scrollTicking) {
        requestAnimationFrame(onScroll);
        scrollTicking = true;
      }
    }, { passive: true });
  })();
</script>

