{% comment %}
  Document head partial. SEO: canonical, og:url, og:site_name, absolute og:image, twitter:image.
{% endcomment %}
{% if animal %}
  {% assign speciesLabel = animal.species | default: "zvíře" %}
  {% assign pageTitle = animal.name | append: " – " | append: speciesLabel | append: " k adopci | Daisy Azyl" %}
  {% assign pageDesc = animal.shortDescription %}
  {% assign pageOgImage = animal.image %}
{% else %}
  {% assign pageTitle = title | default: "Daisy Azyl" %}
  {% assign pageDesc = description %}
  {% assign pageOgImage = ogImage | default: "images/og.png" %}
{% endif %}
{% assign canonicalPath = permalink | default: page.url | default: "/" %}
{% if canonicalPath == "" %}{% assign canonicalPath = "/" %}{% endif %}
{% unless canonicalPath contains "/" %}{% assign canonicalPath = "/" | append: canonicalPath %}{% endunless %}
{% assign canonicalUrl = site.siteUrl | append: canonicalPath %}
{% assign ogImagePath = pageOgImage | default: "images/og.png" %}
{% if ogImagePath contains "http" %}
  {% assign fullOgImage = ogImagePath %}
{% else %}
  {% assign firstChar = ogImagePath | slice: 0, 1 %}
  {% if firstChar == "/" %}
    {% assign fullOgImage = site.siteUrl | append: ogImagePath %}
  {% else %}
    {% assign fullOgImage = site.siteUrl | append: "/" | append: ogImagePath %}
  {% endif %}
{% endif %}
<meta charset="utf-8">
<title>{{ pageTitle }}</title>
<link rel="canonical" href="{{ canonicalUrl }}">
{% if pageDesc %}
<meta content="{{ pageDesc }}" name="description">
<meta content="{{ pageTitle }}" property="og:title">
<meta content="{{ pageDesc }}" property="og:description">
<meta content="{{ fullOgImage }}" property="og:image">
<meta content="{{ canonicalUrl }}" property="og:url">
<meta content="{{ site.siteName }}" property="og:site_name">
<meta content="{{ site.locale }}" property="og:locale">
<meta content="{{ pageTitle }}" property="twitter:title">
<meta content="{{ pageDesc }}" property="twitter:description">
<meta content="{{ fullOgImage }}" property="twitter:image">
<meta property="og:type" content="website">
<meta content="summary_large_image" name="twitter:card">
{% else %}
<meta content="{{ pageTitle }}" property="og:title">
<meta content="{{ canonicalUrl }}" property="og:url">
<meta content="{{ site.siteName }}" property="og:site_name">
<meta content="{{ pageTitle }}" property="twitter:title">
{% endif %}
<meta content="width=device-width, initial-scale=1" name="viewport">
{% if noindex %}
<meta name="robots" content="noindex, nofollow">
{% endif %}
<base href="/">
<meta name="relume-color-schemes" content="false" />
<link href="css/normalize.css" rel="stylesheet" type="text/css">
<link href="css/webflow.css" rel="stylesheet" type="text/css">
<link href="css/daisy-azyl-187ec6.webflow.css" rel="stylesheet" type="text/css">
<script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart" in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
<link href="images/webclip.png" rel="apple-touch-icon"><!--  Keep this css code to improve the font quality -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="apple-mobile-web-app-title" content="Daisy Azyl" />
<link rel="manifest" href="/site.webmanifest" />
{% include "partials/schema.njk" %}
<script>
  window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
</script>
